---
import { comments } from "../data/comments";
import commentTheme from "../styles/giscus.css?url";
import inlineTheme from "../styles/giscus.css?inline";
import darkTheme from "../styles/giscus-dark.css?url";
import inlineDarkTheme from "../styles/giscus-dark.css?inline";
const configured = Boolean(comments.repoId && comments.categoryId);
// An HTTPS iframe cannot reliably load styles from a local HTTP development server.
const development = import.meta.env.DEV;
const themes = {
  light: development
    ? `data:text/css;base64,${Buffer.from(inlineTheme).toString("base64")}`
    : new URL(commentTheme, Astro.site).href,
  dark: development
    ? `data:text/css;base64,${Buffer.from(inlineDarkTheme).toString("base64")}`
    : new URL(darkTheme, Astro.site).href,
};
const discussionsUrl = `https://github.com/${comments.repo}/discussions`;
---

{configured && (
  <section class="guestbook" aria-label="Guestbook messages">
    <div class="guestbook-frame embed-frame">
      <p class="embed-status" role="status" aria-live="polite">
        Comments need JavaScript and a connection to GitHub. You can also view
        the discussion directly below.
      </p>
      <div class="giscus" />
    </div>
    <p class="comments-fallback">
      <a href={discussionsUrl}>View discussions on GitHub</a>
    </p>
  </section>
)}

<style>
  .guestbook {
    margin-top: 24px;
    border-top: 1px solid var(--line);
    padding-top: 20px;
  }

  .comments-fallback {
    margin-top: 12px;
    font-family: var(--sans);
    font-size: 13px;
    line-height: 1.6;
  }

  .guestbook-frame {
    display: grid;
  }

  .guestbook-frame > .embed-status,
  .giscus {
    grid-area: 1 / 1;
    min-width: 0;
  }

  .guestbook-frame > .embed-status {
    /* Share the widget's space without imposing a minimum height. Before the
       iframe arrives, the message itself supplies enough room to stay legible. */
    position: static;
  }

  .giscus :global(iframe) {
    display: block;
    width: 100%;
    border: 0;
  }
</style>

{configured && <script
  is:inline
  define:vars={{ commentConfig: { comments, themes, development } }}
>
  (() => {
    const { comments, themes, development } = commentConfig;
    const container = document.querySelector(".giscus");
    const status = container.parentElement.querySelector(".embed-status");
    const getTheme = () => document.documentElement.dataset.theme || "light";
    const client = document.createElement("script");
    client.src = "https://giscus.app/client.js";
    client.async = true;
    client.crossOrigin = "anonymous";
    Object.assign(client.dataset, {
      repo: comments.repo,
      repoId: comments.repoId,
      category: comments.category,
      categoryId: comments.categoryId,
      mapping: "specific",
      term: "Guestbook",
      strict: "1",
      reactionsEnabled: "0",
      emitMetadata: "0",
      inputPosition: "top",
      theme: development ? getTheme() : themes[getTheme()],
      lang: "en",
      loading: "lazy",
    });

    let readyFrame;
    let appliedTheme;
    let timeout;
    let failed = false;
    const showUnavailable = () => {
      clearTimeout(timeout);
      failed = true;
      status.hidden = false;
      status.textContent =
        "Comments couldn't be loaded here. You can view the discussion on GitHub below.";
    };
    client.addEventListener("error", showUnavailable);
    function syncTheme() {
      const theme = themes[getTheme()];
      client.dataset.theme = development ? getTheme() : theme;
      if (!readyFrame || appliedTheme === theme) return;
      readyFrame.contentWindow.postMessage(
        { giscus: { setConfig: { theme } } },
        "https://giscus.app",
      );
      appliedTheme = theme;
    }
    window.addEventListener("message", (event) => {
      const frame = container.querySelector("iframe");
      if (
        event.origin !== "https://giscus.app" ||
        event.source !== frame?.contentWindow ||
        !event.data?.giscus
      )
        return;
      if (readyFrame !== frame) {
        readyFrame = frame;
        appliedTheme = undefined;
        failed = false;
      }
      const message = event.data.giscus;
      // An empty guestbook has no discussion until its first comment.
      if (
        message.error &&
        !message.error.includes("Discussion not found") &&
        !message.signOut
      ) {
        showUnavailable();
      } else if (message.resizeHeight > 0 && !failed) {
        clearTimeout(timeout);
        status.hidden = true;
      }
      // Also handles a theme change while the lazy iframe was still loading.
      syncTheme();
    });
    document.addEventListener("themechange", syncTheme);
    function load() {
      status.textContent = "Loading comments…";
      timeout = setTimeout(() => {
        status.textContent =
          "Comments haven't loaded. You can view the discussion on GitHub below.";
      }, 12000);
      container.append(client);
    }
    if ("IntersectionObserver" in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          if (!entries.some((entry) => entry.isIntersecting)) return;
          observer.disconnect();
          load();
        },
        { rootMargin: "200px" },
      );
      observer.observe(container.parentElement);
    } else {
      load();
    }
  })();
</script>}
