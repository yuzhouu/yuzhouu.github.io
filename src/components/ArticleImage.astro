---
import SwallowArt from "./SwallowArt.astro";
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
  src: string | ImageMetadata;
  alt?: string;
  title?: string;
  width?: number;
  height?: number;
  loading?: "lazy" | "eager";
}
const { src, alt = "", title, width, height, loading = "lazy" } = Astro.props;
const isSwallow = src === "/assets/swallow.svg";
if (
  typeof src === "string" &&
  !isSwallow &&
  !(width && width > 0 && height && height > 0)
) {
  throw new Error(
    `Image "${src}" needs positive width and height. Use a relative image in src/ for automatic sizing, or a {% image src="..." alt="..." width=1200 height=800 /%} tag for public/ and remote images.`,
  );
}
const widths =
  typeof src === "string"
    ? undefined
    : [
        ...new Set(
          [320, 660, 1320, src.width].filter(
            (size) => size <= Math.min(src.width, 1320),
          ),
        ),
      ];
---

{isSwallow ? (
  <span
    class="article-swallows"
    role="img"
    aria-label={alt || "Swallows in flight"}
  >
    <SwallowArt />
  </span>
) : typeof src !== "string" &&
  (src.format === "svg" || src.format === "gif") ? (
  <img
    src={src.src}
    {alt}
    {title}
    {loading}
    width={width ?? src.width}
    height={
      height ??
      (width ? Math.round((src.height * width) / src.width) : src.height)
    }
    decoding="async"
  />
) : typeof src !== "string" ? (
  <Image
    {src}
    {alt}
    {title}
    {loading}
    width={width ?? Math.min(src.width, 660)}
    {height}
    layout="constrained"
    {widths}
    sizes="(max-width: 600px) calc(100vw - 40px), (max-width: 708px) calc(100vw - 48px), 660px"
    format="webp"
    decoding="async"
  />
) : (
  <img {src} {alt} {title} {width} {height} {loading} decoding="async" />
)}

<style>
  .article-swallows {
    display: block;
    max-width: 140px;
    margin: 1rem auto;
    opacity: 0.75;
  }
</style>
