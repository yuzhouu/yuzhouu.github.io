---
import PostList from "../../components/PostList.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { getPosts } from "../../lib/posts";

const posts = await getPosts();
const years = [
  ...new Set(posts.map((post) => post.data.publishedAt.getUTCFullYear())),
];
---

<SiteLayout title="Posts" active="posts">
  <header class="page-heading">
    <h1>Posts</h1>
    <p>On writing code, making things, and everyday life.</p>
  </header>
  <div class="archive">
    {years.map((year) => (
      <section class="archive-year" aria-labelledby={`year-${year}`}>
        <h2 id={`year-${year}`}>{year}</h2>
        <PostList
          posts={posts.filter(
            (post) => post.data.publishedAt.getUTCFullYear() === year,
          )}
        />
      </section>
    ))}
    {posts.length === 0 && (
      <p class="empty-state">No posts yet. Check back soon.</p>
    )}
  </div>
</SiteLayout>
