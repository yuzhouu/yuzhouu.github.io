---
import { site } from "../data/site";
import ThemeScript from "../components/ThemeScript.astro";
import ThemeControl from "../components/ThemeControl.astro";
import serifFont from "@fontsource-variable/source-serif-4/files/source-serif-4-latin-wght-normal.woff2?url";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  active?: "timeline" | "posts" | "about" | "guestbook";
  article?: boolean;
  publishedAt?: Date;
  updatedAt?: Date;
  lang?: "en" | "zh-CN";
  noindex?: boolean;
}
const {
  title,
  description = site.description,
  active,
  article = false,
  publishedAt,
  updatedAt,
  lang = "en",
  noindex = false,
} = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : site.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const shareImage = new URL("/og.png", Astro.site);
const analyticsHostname = Astro.site?.hostname;
const articleSchema =
  article && publishedAt
    ? {
        "@context": "https://schema.org",
        "@type": "BlogPosting",
        headline: title,
        description,
        url: canonical.href,
        mainEntityOfPage: canonical.href,
        image: [shareImage.href],
        datePublished: publishedAt.toISOString(),
        ...(updatedAt && { dateModified: updatedAt.toISOString() }),
        author: { "@type": "Person", name: site.name, url: site.github },
        inLanguage: lang,
      }
    : undefined;
---

<!doctype html>
<html {lang}>
  <head>
    <meta charset="UTF-8" />
    {import.meta.env.PROD && analyticsHostname && <script
      is:inline
      define:vars={{ analyticsHostname }}
    >
      (() => {
        // Also exclude local previews of the production build.
        if (
          location.hostname !== analyticsHostname ||
          location.protocol !== "https:"
        )
          return;
        window.dataLayer = window.dataLayer || [];
        function gtag() {
          window.dataLayer.push(arguments);
        }
        gtag("js", new Date());
        gtag("config", "G-7VJGWHQDZF");
        const script = document.createElement("script");
        script.async = true;
        script.src = "https://www.googletagmanager.com/gtag/js?id=G-7VJGWHQDZF";
        document.head.append(script);
      })();
    </script>}
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <meta name="theme-color" content="#ffffff" />
    <ThemeScript />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" type="image/png" href="/favicon.png" />
    <link rel="canonical" href={canonical} />
    {active === "guestbook" && (
      <meta name="giscus:backlink" content={canonical.href} />
    )}
    <link
      rel="preload"
      href={serifFont}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={site.title}
      href={new URL("/rss.xml", Astro.site)}
    />
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:locale" content={lang === "zh-CN" ? "zh_CN" : "en_US"} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name} — ${site.tagline}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImage} />
    <meta name="twitter:image:alt" content={`${site.name} — ${site.tagline}`} />
    {publishedAt && (
      <meta
        property="article:published_time"
        content={publishedAt.toISOString()}
      />
    )}
    {updatedAt && (
      <meta
        property="article:modified_time"
        content={updatedAt.toISOString()}
      />
    )}
    {articleSchema && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(articleSchema).replace(/</g, "\\u003c")}
      />
    )}
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <div class="site-shell">
      <header class="site-header">
        <div class="site-identity">
          <a class="brand" href="/" aria-label="Zhou Yu, home">
            <img
              class="brand-mark"
              src="/favicon.svg"
              width="31"
              height="31"
              alt=""
            />
            <span>{site.name}</span>
          </a>
        </div>
        <nav aria-label="Main navigation">
          <a href="/" aria-current={active === "timeline" ? "page" : undefined}>
            Timeline
          </a>
          <a
            href="/about/"
            aria-current={active === "about" ? "page" : undefined}
          >
            About
          </a>
          <a
            href="/guestbook/"
            aria-current={active === "guestbook" ? "page" : undefined}
          >
            Guestbook
          </a>
        </nav>
      </header>
      <main id="main" tabindex="-1">
        <slot />
      </main>
      <footer class="site-footer">
        <div class="footer-meta">
          <span>
            © {new Date().getFullYear()} {site.name}
          </span>
          <a href="/rss.xml">RSS</a>
        </div>
        <ThemeControl />
      </footer>
    </div>
  </body>
</html>
